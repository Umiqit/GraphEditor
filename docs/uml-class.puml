@startuml
title GraphEditor — диаграмма классов (инкременты 1–2)

package ru.grapheditor.pixel {
    abstract class Pixel {
        #x: int
        #y: int
        #color: Color
        +move(dx, dy)
    }
    class Point
    class Circle {
        -radius: int
    }
    class Square {
        -side: int
    }
    enum PixelType {
        POINT
        CIRCLE
        SQUARE
    }
    class PixelFactory {
        +{static} create(type, x, y, color): Pixel
    }

    Pixel <|-- Point
    Pixel <|-- Circle
    Pixel <|-- Square
    PixelFactory ..> Pixel
    PixelFactory ..> PixelType
}

package ru.grapheditor.shape {
    interface Shape {
        +draw(g)
        +contains(x, y)
        +move(dx, dy)
    }
    class Drawing {
        -shapes: List<Shape>
        +add(shape)
        +remove(shape)
        +clear()
        +findAt(x, y)
        +drawAll(g)
    }
    class Polygon {
        -vertices: List<int[]>
    }
    abstract class ShapeDecorator {
        #inner: Shape
    }
    class FillDecorator
    class BorderDecorator
    class ShadowDecorator

    Shape <|.. Pixel
    Shape <|.. Polygon
    Shape <|.. ShapeDecorator
    ShapeDecorator o-- Shape
    ShapeDecorator <|-- FillDecorator
    ShapeDecorator <|-- BorderDecorator
    ShapeDecorator <|-- ShadowDecorator
    Drawing o-- Shape
}

package ru.grapheditor.ui {
    class GraphEditor
    class Canvas {
        -drawing: Drawing
        -selected: Shape
        +clearDrawing()
        +redecorateSelected()
    }
    class ToolSelector {
        -current: Tool
        -color: Color
    }
    enum Tool {
        POINT, CIRCLE, SQUARE,
        POLYGON, SELECT, ERASER
    }
    class DecorationOptions
    class ColorPalette
    class CustomColorDialog

    GraphEditor *-- Canvas
    GraphEditor *-- ToolSelector
    GraphEditor *-- DecorationOptions
    Canvas --> ToolSelector
    Canvas --> Drawing
    ToolSelector --> Tool
    ColorPalette ..> CustomColorDialog
}

Canvas ..> PixelFactory
Canvas ..> Polygon
@enduml
