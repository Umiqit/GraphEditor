@startuml
title GraphEditor v1.0 — диаграмма классов

package ru.grapheditor {
    class Settings {
        -backgroundColor: Color
        -defaultBorderWidth: float
        -defaultShadowOffsetX/Y: int
    }
}

package ru.grapheditor.pixel {
    abstract class Pixel {
        #x: int
        #y: int
        #color: Color
    }
    class Point
    class Circle {
        -radius: int
    }
    class Square {
        -side: int
    }
    enum PixelType {
        POINT
        CIRCLE
        SQUARE
    }
    class PixelFactory {
        +{static} create(type, x, y, color): Pixel
    }

    Pixel <|-- Point
    Pixel <|-- Circle
    Pixel <|-- Square
    PixelFactory ..> Pixel
    PixelFactory ..> PixelType
}

package ru.grapheditor.shape {
    interface Shape {
        +draw(g)
        +contains(x, y)
        +move(dx, dy)
    }
    class Drawing {
        -shapes: List<Shape>
        +add(shape)
        +remove(shape)
        +clear()
        +findAt(x, y)
        +snapshot()/restore(list)
    }
    class Polygon {
        -vertices: List<int[]>
        +setVertex(i, x, y)
        +setVertices(points)
    }
    abstract class ShapeDecorator {
        #inner: Shape
    }
    class FillDecorator
    class BorderDecorator
    class ShadowDecorator

    Shape <|.. Pixel
    Shape <|.. Polygon
    Shape <|.. ShapeDecorator
    ShapeDecorator o-- Shape
    ShapeDecorator <|-- FillDecorator
    ShapeDecorator <|-- BorderDecorator
    ShapeDecorator <|-- ShadowDecorator
    Drawing o-- Shape
}

package ru.grapheditor.command {
    interface Command {
        +execute()
        +undo()
    }
    class History {
        -undoStack: Deque<Command>
        -redoStack: Deque<Command>
        +execute(cmd)
        +pushExecuted(cmd)
        +undo()/redo()
    }
    class CreateShapeCommand
    class DeleteShapeCommand
    class MoveShapeCommand
    class RedecorateCommand
    class ClearDrawingCommand
    class LambdaCommand

    Command <|.. CreateShapeCommand
    Command <|.. DeleteShapeCommand
    Command <|.. MoveShapeCommand
    Command <|.. RedecorateCommand
    Command <|.. ClearDrawingCommand
    Command <|.. LambdaCommand
    History o-- Command
}

package ru.grapheditor.storage {
    interface DrawingStorage {
        +formatName()
        +extension()
        +save(drawing, file)
        +load(file): Drawing
    }
    class JavaSerializationStorage
    class TextStorage
    abstract class RasterImageStorage {
        +save(drawing, file)
        +load(file): Drawing
        #{abstract} embed(image, payload)
        #{abstract} extract(image)
    }
    class PngStorage
    class JpegStorage
    class Storages {
        +{static} ALL: List<DrawingStorage>
        +{static} byExtension(ext)
    }

    DrawingStorage <|.. JavaSerializationStorage
    DrawingStorage <|.. TextStorage
    DrawingStorage <|.. RasterImageStorage
    RasterImageStorage <|-- PngStorage
    RasterImageStorage <|-- JpegStorage
    Storages o-- DrawingStorage
    DrawingStorage ..> Drawing
}

package ru.grapheditor.ui {
    class GraphEditor
    class Canvas {
        -drawing: Drawing
        -history: History
        -selected: Shape
        -dragMode: DragMode
        +undo()/redo()
        +deleteSelected()
        +newDrawing()
        +setDrawingContent(d)
        +clearDrawing()
        +redecorateSelected()
        +applySettings()
        +detectHandle(x, y): DragMode
        +dragSelected(x, y)
        +releaseSelected(x, y)
    }
    enum DragMode {
        NONE, MOVE, VERTEX, RESIZE
    }
    class ToolSelector
    enum Tool {
        POINT, CIRCLE, SQUARE,
        POLYGON, SELECT, ERASER
    }
    class DecorationOptions
    class ColorPalette
    class CustomColorDialog

    GraphEditor *-- Canvas
    GraphEditor *-- ToolSelector
    GraphEditor *-- DecorationOptions
    GraphEditor --> Settings
    Canvas --> ToolSelector
    Canvas --> History
    Canvas --> Drawing
    Canvas ..> DragMode
    GraphEditor --> History
    Canvas ..> PixelFactory
    Canvas ..> Polygon
    ColorPalette ..> CustomColorDialog
    ToolSelector --> Tool
}

History ..> Drawing
@enduml
